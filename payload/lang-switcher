#!/bin/sh
# lang-switcher managed command
manager="$HOME/.local/share/lang-switcher/manager.py"
action="${1:-status}"
if [ "$#" -gt 0 ]; then shift; fi
case "$action" in
    status|update|rollback|uninstall)
        exec python3 "$manager" "--$action" "$@" ;;
    restore)
        exec python3 "$manager" --restore "$@" ;;
    layout|case)
        exec "$HOME/.local/share/lang-switcher/current/bin/python" "$HOME/.local/lib/lang-switcher/switcher.py" "--$action" "$@" ;;
    completion)
        if [ "$#" -gt 1 ]; then
            printf '%s\n' 'Использование: lang-switcher completion bash' >&2
            exit 2
        fi
        case "${1:-bash}" in
            bash) exec cat "$HOME/.local/share/bash-completion/completions/lang-switcher" ;;
            -h|--help) printf '%s\n' 'source <(lang-switcher completion bash)' ;;
            *) printf '%s\n' 'Поддерживается автодополнение Bash.' >&2; exit 2 ;;
        esac ;;
    help|--help|-h)
        exec python3 "$manager" --commands "$@" ;;
    *)
        printf '%s\n' "Неизвестная команда: $action. Справка: lang-switcher help" >&2
        exit 2 ;;
esac
